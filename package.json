{
  "name": "defluff",
  "version": "0.0.0",
  "private": true,
  "description": "Strip AI-generated fluff from email. Zero-retention, BYOK, open source.",
  "homepage": "https://github.com/FinAegis/defluff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FinAegis/defluff.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "icons": "node scripts/generate-icons.mjs",
    "skill:publish": "node scripts/publish-skill.mjs",
    "package:chrome": "pnpm --filter @defluff/extension package"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
